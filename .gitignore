# The built PDFs and the generated HTML are committed on purpose: most people
# want to print the form, not install a toolchain. Nothing else from build/.
build/*
!build/navlog-*.html
!build/NavLog-A4-3up-*.pdf

__pycache__/
*.pyc
.venv/

# Photos of filled-in logs are private flight data — never commit them here.
# docs/preview-*.png is generated from the PDF, so it is exempt.
*.jpg
*.jpeg
*.heic
*.JPG
*.JPEG

